  "chips/g100.yaml": {
   "name": "G100",
   "revision": "0.1.0",
   "description": "Throughput-oriented digital GPU on GRX28. The 420M-gate, 48 MB SRAM profile is the pre-split GRXGPU/PTA planning block; the photonic PTA chiplet is now defined separately in chips/pta.yaml and is not part of this die.",
   "tech": "grx28.yaml",
   "library": "lp28_7t5_1f",
   "gates_m": 420,
   "ff_ratio": 0.06,
   "sram_mb": 48,
   "io_mm2": 8.0,
   "logic_depth_fo4": 22,
   "activity": 0.18,
   "target_freq_ghz": 0.75,
   "vdd": 0.9,
   "mbff_bits": 4,
   "upsize_fins": 1,
   "pin_aware": true,
   "package": "mcm_si@0.1.0",
   "notes": "7.5T single-finger is the density play at 28 nm. The risk is not cell height but pin access and long-wire drive. MBFF-4 and pin-density-aware placement are assumed in the reference configuration. 1.5 GHz is not a 28 nm target; the model's native capability at 22 FO4 stages is the realistic ceiling here. Every value is a planning assumption, not a G100 design database."
  },
  "packages/mcm_si.yaml": {
   "schema_version": "0.1",
   "id": "mcm_si",
   "revision": "0.1.0",
   "kind": "silicon_interposer",
   "description": "2.5D silicon interposer carrying one G100 digital die and one PTA photonic die. The stack is defined for provenance and future package/yield engines; this file does not claim an assembly process or a known-good-die model.",
   "evidence": "assumed",
   "chiplets": [
    {
     "product": "g100@0.1.0",
     "role": "electronic",
     "required": true
    },
    {
     "product": "pta@0.1.0",
     "role": "photonic",
     "required": true
    }
   ],
   "interposer": {
    "material": "silicon",
    "thickness_um": 100.0,
    "routing_layers": 4,
    "min_trace_width_um": 1.5,
    "min_trace_spacing_um": 1.5,
    "dielectric_thickness_um": 1.0,
    "tsv_diameter_um": 10.0
   },
   "bumps": {
    "type": "microbump",
    "diameter_um": 10.0,
    "pitch_um": 20.0,
    "underfill": "capillary"
   },
   "assembly": {
    "die_attach": "pick-and-place",
    "lid": "planned",
    "test": "known-good-die matching required"
   },
   "notes": "Microbump, trace and dielectric dimensions follow the concept-document planning geometry. They are not a foundry or OSAT rule deck. Thermal, parasitic, warpage and assembly-yield models are Phase 3 work."
  },
