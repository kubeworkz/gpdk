   "as_built": {
    "label": "RISC-V test chip (measured silicon)",
    "node_note": "Node not disclosed in the source data. The implied 34 um2/NAND2 and 51 um2/SRAM bit are consistent with a 0.5 um-class or rad-hard process, roughly one hundred times less dense than GRX28.",
    "die_mm2": 165.0,
    "die_xy_mm": [
     12.9,
     12.9
    ],
    "core_mm2": 140.6,
    "content_mm2": 86.4,
    "logic_mm2": 46.2,
    "sram_mm2": 40.2,
    "sram_kb": 96,
